# =============================================================================
# .env.example
# Intent-Aware Multi-Agent AI Orchestration in Edge-Cloud Continuum
# =============================================================================
#
# HOW TO USE:
#   1. Copy this file and rename it to .env
#   2. Fill in your actual values (remove the placeholder text)
#   3. Never commit .env to version control (add it to .gitignore)
#
# NOTE: The system works fully in mock mode without any of these keys.
#       These are only needed for optional internet-aware features.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# OLLAMA (local LLM — free, no key needed)
# Install from https://ollama.com then pull a model:
#   ollama pull llama3.2:8b-instruct-q4_K_M
# ─────────────────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:8b-instruct-q4_K_M

# ─────────────────────────────────────────────────────────────────────────────
# EXPERIMENT SETTINGS (override OrchestratorAgent.py defaults via env)
# ─────────────────────────────────────────────────────────────────────────────
NUM_APPS=30
RANDOM_SEED=42
LLM_BACKEND=mock

# ─────────────────────────────────────────────────────────────────────────────
# OUTPUT DIRECTORIES
# ─────────────────────────────────────────────────────────────────────────────
OUTPUT_DIR=./experiment_results
FIGURES_DIR=./figures_output
